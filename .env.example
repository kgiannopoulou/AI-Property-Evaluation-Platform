# Copy to .env (repository root) and fill in. Never commit real values.
# The backend and ai-service read this file; nothing here is exposed to the browser
# (Next.js only exposes variables prefixed with NEXT_PUBLIC_, set in frontend/.env.local).

# Database (backend)
DATABASE_URL=jdbc:postgresql://localhost:5437/property_intelligence
DATABASE_USER=property
POSTGRES_PASSWORD=

# Photo storage, shared by the backend (writes) and the ai-service (reads).
#   local    - a directory on this machine (development)
#   supabase - a private Supabase Storage bucket (ai-service reads with the service-role key)
PHOTO_STORAGE=local
PHOTO_DIR=../.data/photos
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=property-photos

# AI image analysis (ai-service)
ANTHROPIC_API_KEY=
AI_VISION_MODEL=claude-opus-5-5
# Repair-cost ranges in the table are illustrative placeholders, not verified local data.
# Keep false unless you want them shown (they are labelled "illustrative" when shown).
INCLUDE_ILLUSTRATIVE_COSTS=false

# Backend -> ai-service. The token is a shared secret: generate a long random value.
AI_SERVICE_URL=http://localhost:8090
AI_SERVICE_TOKEN=

# Backend: the website origin allowed to call the API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Maps (location intelligence)
MAPS_API_KEY=

# Payments (backend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend -> backend URL (public, not a secret). Put it in frontend/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8080
