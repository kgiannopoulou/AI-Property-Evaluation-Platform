# Copy to .env and fill in. Never commit real values.
# Only the backend and ai-service read these; nothing here is exposed to the browser
# (Next.js only exposes variables prefixed with NEXT_PUBLIC_).

# Database (backend)
DATABASE_URL=jdbc:postgresql://localhost:5437/property_intelligence
DATABASE_USER=property
POSTGRES_PASSWORD=

# Object storage for photos and documents (backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI vision / text model (ai-service)
OPENAI_API_KEY=

# Maps (location intelligence)
MAPS_API_KEY=

# Payments (backend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend -> backend URL (public, not a secret)
NEXT_PUBLIC_API_URL=http://localhost:8080
